{
  "name": "ncpmi-chatbot",
  "private": true,
  "description": "NCPMI Chatbot: Cloudflare Worker deploy + knowledge-base scraper (the Express server lives in server/)",
  "type": "module",
  "scripts": {
    "scrape": "node scripts/scrape.mjs",
    "dev": "wrangler dev",
