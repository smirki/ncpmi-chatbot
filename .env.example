# ============================================================
#  NCPMI Chatbot — environment configuration
#  Copy this file to ".env" and fill in the values.
#    cp .env.example .env
#  NEVER commit your real .env — it is gitignored.
# ============================================================

# ---- LLM provider -------------------------------------------------
# The server talks to any OpenAI-compatible chat-completions API.
# The variables are named LLAMA_* for legacy reasons but currently
# point at Google Gemini's OpenAI-compatible endpoint.
#
# Get a Gemini API key at https://aistudio.google.com/apikey
LLAMA_API_KEY=your-gemini-api-key-here
LLAMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLAMA_MODEL=models/gemini-flash-latest

# Gemini "thinking" level: minimal | low | medium | high
# (gemini-flash-latest is a Gemini 3 model — thinking can't be fully
#  turned off; "minimal" is the lowest setting.)
THINKING_LEVEL=minimal

# ---- Server -------------------------------------------------------
PORT=3002

# Password for the admin dashboard at /admin. CHANGE THIS.
ADMIN_PASSWORD=change-me

# ---- CORS (production) --------------------------------------------
# Comma-separated list of allowed origins. Leave unset to allow all
# origins (fine for local development).
# CORS_ORIGINS=https://ncpmi.org,https://www.ncpmi.org
